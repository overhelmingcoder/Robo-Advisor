OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=openrouter/free
AI_MODEL_FALLBACKS=nvidia/nemotron-3-super-120b-a12b:free,openai/gpt-oss-120b:free,google/gemma-4-31b-it:free
OPENROUTER_MAX_TOKENS=900
CHAT_MAX_TOKENS=420

# Optional LiteLLM gateway (takes precedence when both variables are set)
LITE_LLM_URL=localhost:4000
LITELLM_MASTER_KEY=your-lite-llm-master-key
# Optional model for LiteLLM (defaults to OPENROUTER_MODEL when omitted)
LITELLM_MODEL=openrouter/free
